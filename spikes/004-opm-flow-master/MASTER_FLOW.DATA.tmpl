  'SAT' 'MANIFOLD' 9999 /
  'MANIFOLD' 'FIELD' 3 /
/
NODEPROP
  'FIELD' 20.0 /
  'MANIFOLD' /
  'PLAT' /
  'SAT' /
/
WCONPROD
