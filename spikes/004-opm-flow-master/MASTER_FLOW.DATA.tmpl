  'N-P2' 'OPEN' 'ORAT' __Y2_N_P2_ORAT__ 3* 1* 50.0 10.0 1 /
  'H-P1' 'OPEN' 'ORAT' __Y2_H_P1_ORAT__ 3* 1* 50.0 10.0 2 /
  'H-P2' 'OPEN' 'ORAT' __Y2_H_P2_ORAT__ 3* 1* 50.0 10.0 2 /
/
TSTEP
  365 /
GSATPROD
  'SAT' __Y3_SAT_OIL_SM3D__ 0.0 __Y3_SAT_GAS_SM3D__ /
/
WCONPROD
