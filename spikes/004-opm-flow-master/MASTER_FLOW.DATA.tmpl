  'N-P2' 'OPEN' 'ORAT' __Y3_N_P2_ORAT__ 3* 1* 50.0 10.0 1 /
  'H-P1' 'OPEN' 'ORAT' __Y3_H_P1_ORAT__ 3* 1* 50.0 10.0 2 /
  'H-P2' 'OPEN' 'ORAT' __Y3_H_P2_ORAT__ 3* 1* 50.0 10.0 2 /
/
TSTEP
