-- ============================================================================
-- MASTER.DATA -- ILLUSTRATIVE deck for the coupled-simulation example.
--
-- Role: "reservoir dummy with the network model". A tiny black-oil grid
-- whose production system is a subsea network (manifold + risers) modelled
-- OUTSIDE the grid with the NETWORK family of keywords.
--
-- !!! This deck is NOT executed by the example (no Eclipse licence needed).
--     The dummy simulator (bin/eclipse_dummy.py) reads simspec.json next
--     to this file instead. Replace this file with your real master model
--     from your FMU setup when going to production.
-- ============================================================================
RUNSPEC
TITLE
  COUPLED EXAMPLE - MASTER (DUMMY RESERVOIR + NETWORK MODEL)
DIMENS
  5 5 3 /
OIL
WATER
GAS
DISGAS
METRIC
START
  1 JAN 2024 /
WELLDIMS
  4 40 1 2 /
UNIFOUT

GRID
DX
  75*100 /
DY
  75*100 /
DZ
  75*10 /
TOPS
  25*2000 /
PORO
  75*0.25 /
PERMX
  75*300 /
PERMY
  75*300 /
PERMZ
  75*30 /

PROPS
PVTW
  400.0 1.0 4.5E-5 0.9 5.0E-4 /
ROCK
  400.0 4.5E-5 /
PVDO
  300.0 1.10 1.20
  400.0 1.00 1.00
  500.0 0.90 0.80 /
SWOF
  0.20 0.0 1.0 0.0
  0.40 0.1 0.6 0.0
  0.60 0.5 0.2 0.0
  0.80 1.0 0.0 0.0 /
DENSITY
  850.0 1000.0 0.7 /

SOLUTION
EQUIL
  2010.0 400.0 2000.0 0.0 2000.0 0.0 /
RSVD
  2010.0 0.25
  2010.0 0.25 /

SCHEDULE
RPTRST
  BASIC=2 /
WELSPECS
  'M-P1' 'G1' 2 2 2010.0 'OIL' /
/
COMPDAT
  'M-P1' 2 2 1 3 'OPEN' 1* 1* 0.3 /
/
-- ---------------------------------------------------------------------------
-- Prescribed production profiles are INPUTS TO this master/network model.
-- They represent external subsea wells that are not simulated in model_a or
-- model_b. The row layout is illustrative: replace it with the exact
-- GSATPROD/GSATPTAB syntax used by your Eclipse version and current deck.
-- ---------------------------------------------------------------------------
INCLUDE
  'profiles/gsatprod_external.inc' /
-- ---------------------------------------------------------------------------
-- The subsea network receives those prescribed profiles PLUS dynamic rates
-- from model_a and model_b. This NETWORK block is only a structural sketch;
-- replace it with the nodes, branches, well connections and controls from
-- your real master model.
-- ---------------------------------------------------------------------------
INCLUDE
  'network/network.inc' /
WCONPROD
  'M-P1' 'OPEN' 'ORAT' 500.0 4* 2500.0 /
/
TSTEP
  365.0 /
