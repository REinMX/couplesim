{
  "title": "Coupled reservoir + network simulation example: master_network + model_n + model_hdn",
  "schedule": {
    "start": "2024-01-01",
    "years": 3,
    "steps_per_year": 1
  },
  "coupling": {
    "max_iterations": 6,
    "tolerance": 0.005
  },
  "initial_rates_sm3d": {
    "N-P1": 500.0,
    "N-P2": 600.0,
    "H-P1": 400.0,
    "H-P2": 450.0
  },
  "master": {
    "model": "master_network",
    "deck": "MASTER.DATA"
  },
  "slaves": {
    "model_n": {
      "mode": "coupled",
      "deck": "MODEL_N.DATA"
    },
    "model_hdn": {
      "mode": "coupled",
      "deck": "MODEL_HDN.DATA"
    }
  }
}
