-- ============================================================================
-- Stage 1: coupled multi-model reservoir + network simulation.
--
-- One realization = THREE models run "at the same time" through a single
-- forward-model step (RUN_COUPLED):
--     master_network  dummy reservoir + shared subsea network      (master)
--                     consumes prescribed external GSATPROD profiles PLUS
--                     simulated production from both slaves
--     model_a         dynamic reservoir/well simulation             (slave)
--     model_b       dynamic reservoir/well simulation             (slave)
--
-- Exchange loop: slave rates -> master network -> pressure constraints ->
-- both slaves -> new rates -> convergence. The prescribed external profile
-- remains an independent, immutable input to the master at every iteration.
-- The driver lives in ert/bin/scripts/run_coupled.py; the licence-free model
-- adapter is bin/eclipse_dummy.py. Optional real OPM Flow backends for the
-- master and each slave are selectable via coupling.json ("backend": "flow")
-- or the driver's repeatable --backend <model> <backend> flag; see README.md
-- "Hybrid mode". See coupling.json and README.md for the work required to
-- replace the rest with real Eclipse or OPM Flow adapters.
--
-- Your FMU setups use 100 realizations: set NUM_REALIZATIONS 100 when you
-- plug in the real decks. For quick local checks keep it small (2) or use:
--     ert test_run 01_coupled.ert
-- ============================================================================

NUM_REALIZATIONS      2
RANDOM_SEED           20260804

QUEUE_SYSTEM          LOCAL
-- Memory, not cores, is the binding constraint on a small box; with real
-- simulators each slot also holds one flow/eclipse process per model.
QUEUE_OPTION LOCAL MAX_RUNNING 2

DEFINE  <CASE_DIR>      01_coupled

RUNPATH       ../../output/<CASE_DIR>/realization-<IENS>/iter-<ITER>
ENSPATH       ../../output/<CASE_DIR>/storage
RUNPATH_FILE  ../../output/<CASE_DIR>/runpath_file

-- ECLBASE is a path *inside* the runpath (FMU convention). With the dummy
-- simulators no UNSMRY is produced; with real simulators each model needs
-- its own summary at the FMU-convention path (see README.md).
ECLBASE       eclipse/model/MASTER

-- --- Uncertain parameters --------------------------------------------------
-- One scalar per realization: reservoir productivity multiplier sampled
-- from a uniform prior. Both simulated slaves scale their q0 with it, so every
-- realization produces slightly different rates -- the same role that
-- permeability/rock parameters play in your 100-realisation FMU setups.
GEN_KW  Q0_MULT  ../../input/templates/q0_mult.tmpl  q0_mult.txt  ../../input/distributions/q0_priors.txt

-- --- The forward model -----------------------------------------------------
-- One step per realization: the coupled driver stages the three models
-- into the runpath and runs the master/slave coupling loop.
INSTALL_JOB  RUN_COUPLED  ../bin/jobs/RUN_COUPLED

FORWARD_MODEL RUN_COUPLED

-- --- Responses (with real simulators, uncomment and list every key) --------
-- SUMMARY  FOPR  FOPT
-- SUMMARY  WOPR:*  WBHP:*
