-- ERT forward-model step definition ("job"), installed with INSTALL_JOB.
-- EXECUTABLE is resolved relative to this file (ert/bin/jobs/), so
-- ../scripts/run_coupled.py resolves to ert/bin/scripts/run_coupled.py.
-- ERT runs the step with cwd == realization runpath; the driver uses that
-- to find the GEN_KW result file (q0_mult.txt) and to write the coupling
-- files, matching the FMU realization-<IENS>/iter-<ITER> layout.
EXECUTABLE  ../scripts/run_coupled.py
