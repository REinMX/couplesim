-- ERT forward-model step for a standalone model_hdn realization.
-- Runs model_hdn once against static reference-IPR constraints (see
-- ert/bin/scripts/run_standalone.py). The simulator backend comes from
-- coupling.json (default: real OPM Flow).
EXECUTABLE  ../scripts/run_standalone.py
-- Note: "--" starts a comment in ERT job syntax, so the flag must be quoted.
ARGLIST     "--model" model_hdn
