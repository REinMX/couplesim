{
  "title": "Legacy one-way profile source plus two coupled reservoir slaves",
  "schedule": {
    "start": "2024-01-01",
    "years": 3,
    "steps_per_year": 1
  },
  "coupling": {
    "max_iterations": 12,
    "tolerance": 0.005,
    "relaxation": 0.6
  },
  "prescribed_network_profiles": {
    "external_satellite": {
      "keyword": "GSATPROD",
      "path": "input/master_network/profiles/gsatprod_external.inc"
    }
  },
  "initial_slave_rates_sm3d": {
    "A-P1": 500.0,
    "A-P2": 600.0,
    "B-P1": 400.0,
    "B-P2": 450.0
  },
  "master": {
    "model": "master_network",
    "deck": "MASTER.DATA"
  },
  "slaves": {
    "model_a": {
      "role": "coupled_slave",
      "deck": "MODEL_A.DATA",
      "backend": "flow"
    },
    "model_b": {
      "role": "coupled_slave",
      "deck": "MODEL_B.DATA",
      "backend": "flow"
    }
  }
}
